# Local SQLite file. The path is relative to prisma/schema.prisma.
DATABASE_URL="file:../data/hearthlight.db"

# Required. Use a long random string in any shared or production deployment.
SESSION_SECRET="dev-only-change-this-secret-to-32chars-min"

# Public address encoded in the birthday gift-card QR code.
# Use your real https origin once the app is hosted.
# Leave the example host only for design previews.
PUBLIC_BASE_URL="http://127.0.0.1:43123"

# local writes to data/uploads. Use s3 for Aliyun OSS or Tencent COS.
STORAGE_DRIVER="local"

# Aliyun OSS (Hong Kong example) or Tencent COS. Both speak the S3 API.
# S3_ENDPOINT="https://oss-cn-hongkong.aliyuncs.com"
# S3_REGION="oss-cn-hongkong"
# S3_BUCKET="hearthlight"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Virtual-hosted style for Aliyun OSS and Tencent COS.
# S3_FORCE_PATH_STYLE="false"

# Speech-to-text. transformers runs Whisper on this server (no Google).
# http posts the WAV to your own China-reachable endpoint. See README.
STT_PROVIDER="transformers"
STT_MODEL="Xenova/whisper-base"
# STT_CACHE_DIR="./data/models"
# If Hugging Face is hard to reach, point at a mirror or a pre-seeded cache.
# HF_ENDPOINT="https://hf-mirror.com"
# STT_HTTP_URL="http://127.0.0.1:9000/v1/audio/transcriptions"
# STT_HTTP_KEY=""
# STT_HTTP_FORMAT="openai"
