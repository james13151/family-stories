{
  "name": "hearthlight",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 43123",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 43123",
    "lint": "eslint",
    "setup": "prisma generate && prisma db push && tsx scripts/seed.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:reset": "tsx scripts/seed.ts --reset",
    "check": "tsx scripts/check-content.ts && tsx scripts/check-frequency.ts && tsx scripts/check-memoir.ts",
    "gift-card:sample": "tsx scripts/gift-card-sample.ts",
    "android:url": "tsx scripts/print-capacitor-url.ts",
    "android:sync": "cap sync android",
    "android:debug": "cap sync android && cd android && ./gradlew assembleDebug",
    "android:release": "cap sync android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
