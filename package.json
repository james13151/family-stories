    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "jose": "^6.2.18",
    "lucide-react": "^1.80.0",
    "next": "15.5.29",
    "opencc-js": "^1.4.2",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.0",
    "qrcode": "^1.5.4",
