generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  name               String
  locale             String    @default("en")
  frequency          String    @default("weekly")
  customIntervalDays Int       @default(14)
  promptsPerDay      Int       @default(1)
  promptsLeft        Int       @default(1)
  cycleIndex         Int       @default(0)
  nextPromptAt       DateTime?
  onboarded          Boolean   @default(false)
  familyRole         String    @default("")
  childhoodPlace     String    @default("")
  placesLived        String    @default("")
  occupation         String    @default("")
  importantPeople    String    @default("")
  hobbies            String    @default("")
  openTopics         String    @default("[]")
  skipTopics         String    @default("[]")
  plan               String    @default("gift")
  planStatus         String    @default("active")
  stripeCustomerId   String    @default("")
  stripeSubscriptionId String @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  stories            Story[]
  memoirs            Memoir[]
  printIntents       PrintIntent[]
}

model Memoir {
  id            String   @id @default(cuid())
  userId        String
  book          String   @default("life")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String   @default("")
  subtitle      String   @default("")
  authorName    String   @default("")
  grouping      String   @default("stage")
  dedication    String   @default("")
  preface       String   @default("")
  trim          String   @default("a5")
  cover         String   @default("hardcover")
  paper         String   @default("uncoated")
  coverStyle    String   @default("seal")
  storyTemplate String   @default("classic")
  structureJson String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, book])
}

// A later print checkout. This version never charges and does not create rows.
model PrintIntent {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           String   @default("draft")
  trim             String   @default("a5")
  cover            String   @default("hardcover")
  paper            String   @default("uncoated")
  currency         String   @default("HKD")
  amountCents      Int      @default(0)
  partnerSku       String   @default("")
  stripeCheckoutId String   @default("")
  note             String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, createdAt])
}

model Story {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId   String?
  questionText String
  title        String   @default("")
  bodyHtml     String   @default("")
  formatJson   String   @default("{}")
  kind         String   @default("life")
  childName    String   @default("")
  theme        String   @default("")
  stage        String   @default("")
  place        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  audio        Audio?
  photos       Photo[]

  @@index([userId, updatedAt])
}

model Audio {
  id          String   @id @default(cuid())
  storyId     String   @unique
  story       Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storageKey  String
  mimeType    String
  bytes       Int
  durationSec Float?
  transcript  String   @default("")
  sttProvider String   @default("")
  createdAt   DateTime @default(now())
}

model Photo {
  id         String   @id @default(cuid())
  storyId    String
  story      Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  storageKey String
  mimeType   String
  bytes      Int
  caption    String   @default("")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([storyId, sortOrder])
}
